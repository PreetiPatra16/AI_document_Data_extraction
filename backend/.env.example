API_ENV=development
API_TITLE=AI Document Data Extraction API
API_VERSION=1.0.0
HOST=0.0.0.0
PORT=8000
STORAGE_DIR=storage
TEMP_DIR=temp_uploads
MODEL_DIR=models
TROCR_MODEL_PATH=models/trocr-handwritten
MAX_UPLOAD_BYTES=52428800
MAX_PDF_PAGES=100
UPLOAD_CHUNK_BYTES=1048576
JOB_TIMEOUT_SECONDS=900
MAX_JOB_ATTEMPTS=2
WORKER_POLL_SECONDS=1
WORKER_CONCURRENCY=1
ORPHAN_MAX_AGE_HOURS=24
ACCEPTED_CONFIDENCE=0.85
REVIEW_CONFIDENCE=0.70
PADDLE_REQUIRED=true
PADDLE_DETECTION_MODEL=PP-OCRv5_mobile_det
PADDLE_RECOGNITION_MODEL=en_PP-OCRv5_mobile_rec
TROCR_REQUIRED=true
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
